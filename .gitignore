# ==============================
# Secrets / Environment
# ==============================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

secrets/
secret/
credentials/
credentials.json

# ==============================
# SSH private keys
# ==============================

id_rsa
id_dsa
id_ecdsa
id_ed25519

# Note: *.pub is deliberately NOT ignored. Public keys are not secrets, and
# ignoring them silently drops files you may want tracked (authorized_keys
# material, host keys pinned in config). The private-key patterns above are the
# ones that matter.

# ==============================
# Editors
# ==============================

.vscode/
.idea/
*.swp
*.swo
*~

