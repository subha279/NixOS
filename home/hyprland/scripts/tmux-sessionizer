#!/usr/bin/env bash

set -euo pipefail

# Directories to search recursively
SEARCH_DIRS=(
    "$HOME/Sunflower"
    "$HOME/Projects"
)

# Icons — plain emoji rather than Nerd Font glyphs, so they render in any
# terminal without needing a patched font. The rest of the script only ever
# refers to these two variables, never the raw characters, so swapping them
# for something else (Nerd Font glyphs, plain letters, nothing) is a one-line
# change.
ICON_SESSION=" " # tmux session
ICON_DIR=" "     # directory

# Switch to a session if already inside tmux, otherwise attach to it
enter_session() {
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$1"
    else
        tmux attach-session -t "$1"
    fi
}

# Find directories + existing tmux sessions
# `|| true` stops a cancelled fzf (or a `find` permission error on some
# subdirectory) from tripping `set -e` before we reach the empty-selection
# check below.
selected="$(
    {
        # Existing tmux sessions
        tmux list-sessions -F "${ICON_SESSION} #{session_name}" 2>/dev/null || true

        # All directories recursively, pruning VCS/dependency/cache dirs
        # instead of just filtering them: faster (find never descends into
        # them) and correct (the excluded dirs themselves no longer show up
        # as pickable entries).
        {
            for dir in "${SEARCH_DIRS[@]}"; do
                [[ -d "$dir" ]] || continue

                find "$dir" \
                    \( -path '*/.git' -o -path '*/.cache' -o -path '*/node_modules' -o -path '*/.local/share' \) \
                    -prune -o -type d -print \
                    2>/dev/null
            done
        } | sed "s|^|${ICON_DIR} |"
    } |
        sort -u |
        fzf --height 60% --layout=reverse --border --prompt='Project ❯ ' \
            --pointer='' \
            --border-label=" ${ICON_DIR} Sessionizer " \
            --color=bg:-1,bg+:-1,gutter:-1
)" || true

# Nothing selected
[[ -n "$selected" ]] || exit 0

# Existing tmux session
if [[ "$selected" == "$ICON_SESSION"* ]]; then
    session="${selected#"$ICON_SESSION" }"
    enter_session "$session"
    exit 0
fi

# Selected directory
path="${selected#"$ICON_DIR" }"
directory="$(realpath "$path")"

# Create a safe session name
session="$(
    basename "$directory" |
        tr '[:upper:]' '[:lower:]' |
        tr -cs '[:alnum:]_-' '_'
)"

# Create session if it doesn't exist
if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -ds "$session" -c "$directory"
fi

# Enter session
enter_session "$session"
