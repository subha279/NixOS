    color: @sunflower_text;
}

notebook tab:checked {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ------------------------------------------------------------
 * Progress / scales
 * ------------------------------------------------------------ */

progressbar trough,
scale trough {
    background-color: @sunflower_surface_hover;
}

progressbar progress,
scale highlight {
    background-color: @sunflower_accent;
}

/* ------------------------------------------------------------
 * Tooltips
 * ------------------------------------------------------------ */

tooltip,
tooltip.background {
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    box-shadow: none;
}

/* ------------------------------------------------------------
 * Separators
 * ------------------------------------------------------------ */

separator {
    background-color: @sunflower_surface_hover;
}

/* ------------------------------------------------------------
 * Focus
 * ------------------------------------------------------------ */

*:focus {
    outline-color: @sunflower_accent;
}

/* ------------------------------------------------------------
 * Selection
 * ------------------------------------------------------------ */

selection {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ============================================================
 * SUNFLOWER — SWAPPY FOCUSED WINDOW FIX
 * ============================================================ */

/* Swappy header bar — focused AND unfocused */
headerbar,
headerbar:backdrop,
headerbar:focus,
headerbar:focus-within,
headerbar.default-decoration,
headerbar.titlebar {
    background: @sunflower_surface;
    background-color: @sunflower_surface;
    background-image: none;
    color: @sunflower_text;
    border: none;
    box-shadow: none;
}

/* The window itself */
window,
window:focus,
window:backdrop {
    background: @sunflower_background;
    background-color: @sunflower_background;
    color: @sunflower_text;
}

/* Headerbar internal containers */
headerbar > box,
headerbar > box > box,
headerbar .title,
headerbar .subtitle {
    background: transparent;
    background-color: transparent;
    color: @sunflower_text;
}

/* Swappy buttons */
headerbar button,
headerbar button:focus,
headerbar button:active,
headerbar button:checked {
    background: @sunflower_surface;
    background-color: @sunflower_surface;
    background-image: none;
    color: @sunflower_text;
    border: 1px solid transparent;
    box-shadow: none;
}

/* Hover */
headerbar button:hover {
    background: @sunflower_surface_hover;
    background-color: @sunflower_surface_hover;
    background-image: none;
    color: @sunflower_text;
    border-color: @sunflower_accent;
}

/* Active */
headerbar button:active,
headerbar button:checked {
    background: @sunflower_accent;
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* Headerbar separators */
headerbar separator,
headerbar separator:backdrop {
    background: @sunflower_surface_hover;
    background-color: @sunflower_surface_hover;
}

/* Headerbar button icons */
headerbar button image {
    color: @sunflower_text;
    -gtk-icon-shadow: none;
}

headerbar button:hover image {
    color: @sunflower_text;
}

headerbar button:active image,
headerbar button:checked image {
    color: @sunflower_background;
}
