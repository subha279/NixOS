/* ============================================================
 * Sunflower GTK 3
 * Generated from the Sunflower semantic palette.
 *
 * base00 = background
 * base01 = surface
 * base02 = surface hover
 * base03 = muted text
 * base04 = secondary text / border
 * base05 = primary text
 * base08 = error
 * base09 = warning
 * base0A = yellow
 * base0B = success
 * base0C = cyan
 * base0D = info
 * base0E = accent
 * ============================================================ */

@define-color sunflower_background #{{base00-hex}};
@define-color sunflower_surface #{{base01-hex}};
@define-color sunflower_surface_hover #{{base02-hex}};
@define-color sunflower_text_muted #{{base03-hex}};
@define-color sunflower_text_secondary #{{base04-hex}};
@define-color sunflower_text #{{base05-hex}};

@define-color sunflower_error #{{base08-hex}};
@define-color sunflower_warning #{{base09-hex}};
@define-color sunflower_yellow #{{base0A-hex}};
@define-color sunflower_success #{{base0B-hex}};
@define-color sunflower_cyan #{{base0C-hex}};
@define-color sunflower_info #{{base0D-hex}};
@define-color sunflower_accent #{{base0E-hex}};
@define-color sunflower_magenta #{{base0F-hex}};

@define-color theme_fg_color @sunflower_text;
@define-color theme_text_color @sunflower_text;
@define-color theme_bg_color @sunflower_background;
@define-color theme_base_color @sunflower_background;
@define-color theme_selected_bg_color @sunflower_accent;
@define-color theme_selected_fg_color @sunflower_background;

/* ============================================================
 * Base
 * ============================================================ */

* {
    -GtkToolButton-icon-spacing: 6;
    -GtkToolItemGroup-expander-size: 16;
    -GtkTreeView-expander-size: 16;
    -GtkTreeView-vertical-separator: 0;
}

window,
.background {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

.view,
.view text,
textview,
textview.view,
text {
    background-color: @sunflower_background;
    color: @sunflower_text;
}
/* ============================================================
 * Global window / CSD decoration
 * ============================================================ */

window,
window.background,
window.csd,
window.solid-csd {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

/* GTK client-side window decoration */

decoration {
    background-color: @sunflower_background;
    border: 1px solid @sunflower_surface_hover;
    border-radius: 12px;
    box-shadow: 0 3px 6px alpha(black, 0.14),
                0 12px 28px alpha(black, 0.28);
}

decoration:backdrop {
    background-color: @sunflower_background;
    border-color: @sunflower_surface;
    box-shadow: 0 2px 4px alpha(black, 0.10),
                0 8px 20px alpha(black, 0.20);
}

/* ============================================================
 * Menubar
 * ============================================================ */

menubar {
    background-color: @sunflower_background;
    color: @sunflower_text;

    border: none;
    box-shadow: none;
}

menubar > menuitem {
    background-color: transparent;
    color: @sunflower_text_secondary;

    padding: 6px 9px;
}

menubar > menuitem:hover {
    background-color: @sunflower_surface_hover;
    color: @sunflower_text;
}

menubar > menuitem:active,
menubar > menuitem:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

menubar:backdrop,
menubar > menuitem:backdrop {
    background-color: @sunflower_background;
    color: @sunflower_text_muted;
}

/* Remove the default GTK light decoration/shadow */

window.csd {
    background-color: @sunflower_background;
}

window.csd decoration {
    background-color: @sunflower_background;
    border: 1px solid @sunflower_surface_hover;
    box-shadow: none;
}

/* ============================================================
 * Headerbar / titlebar
 * ============================================================ */

headerbar,
.titlebar {
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border: none;
    box-shadow: none;

    min-height: 42px;
    padding: 5px 8px;
}

headerbar:backdrop,
.titlebar:backdrop {
    background-color: @sunflower_background;
    color: @sunflower_text_muted;
}

headerbar .title,
headerbar .subtitle {
    color: @sunflower_text;
}

headerbar .subtitle {
    color: @sunflower_text_secondary;
}

/* ============================================================
 * Toolbars / Thunar
 * ============================================================ */

toolbar,
.primary-toolbar,
.toolbar {
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border: none;
    box-shadow: none;
}

toolbar button,
.primary-toolbar button,
.toolbar button {
    background-color: transparent;
    color: @sunflower_text;

    border: 1px solid transparent;
    border-radius: 7px;
}

toolbar button:hover,
.primary-toolbar button:hover,
.toolbar button:hover {
    background-color: @sunflower_surface_hover;
    color: @sunflower_text;
}

toolbar button:active,
.primary-toolbar button:active,
.toolbar button:active {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

toolbar entry,
.primary-toolbar entry,
.toolbar entry {
    background-color: @sunflower_background;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    border-radius: 8px;
}

/* ============================================================
 * Thunar / Tree selection
 * ============================================================ */

treeview.view:selected,
treeview.view:selected:focus,
treeview:selected,
treeview:selected:focus {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

treeview.view:selected:hover,
treeview:selected:hover {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

treeview.view {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

treeview.view:hover {
    background-color: @sunflower_surface;
    color: @sunflower_text;
}

/* ============================================================
 * Thunar file view
 * ============================================================ */

.view {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

.view:hover {
    background-color: @sunflower_surface;
}

.view:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

.view:selected:focus {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

iconview {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

iconview:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ============================================================
 * Buttons
 * ============================================================ */

button {
    background-image: none;
    background-color: @sunflower_surface;

    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    border-radius: 8px;

    box-shadow: none;

    padding: 6px 12px;
    min-height: 28px;
}

button:hover {
    background-color: @sunflower_surface_hover;
    border-color: @sunflower_accent;
}

button:active,
button:checked {
    background-color: @sunflower_accent;
    color: @sunflower_background;
    border-color: @sunflower_accent;
}

button:focus {
    border-color: @sunflower_accent;
    box-shadow: inset 0 0 0 1px @sunflower_accent,
                0 0 0 2px alpha(@sunflower_accent, 0.22);
}

button:disabled {
    background-color: @sunflower_background;
    color: @sunflower_text_muted;
    border-color: @sunflower_surface;
}

/* Flat buttons */

button.flat {
    background-color: transparent;
    border-color: transparent;
}

button.flat:hover {
    background-color: @sunflower_surface_hover;
    border-color: @sunflower_surface_hover;
}

button.flat:active,
button.flat:checked {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ============================================================
 * Entries / search fields
 * ============================================================ */

entry,
spinbutton,
combobox {
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    border-radius: 8px;

    box-shadow: none;

    padding: 7px 10px;
}

entry:hover,
spinbutton:hover,
combobox:hover {
    border-color: @sunflower_text_secondary;
}

entry:focus,
spinbutton:focus,
combobox:focus {
    border-color: @sunflower_accent;
    box-shadow: inset 0 0 0 1px @sunflower_accent,
                0 0 0 2px alpha(@sunflower_accent, 0.22);
}

entry:disabled,
spinbutton:disabled,
combobox:disabled {
    background-color: @sunflower_background;
    color: @sunflower_text_muted;
}

/* Search */

searchbar {
    background-color: @sunflower_surface;
    border: none;
    box-shadow: none;
}

searchbar entry {
    border-radius: 10px;
}

/* ============================================================
 * Menus / popovers
 * ============================================================ */

menu,
.menu,
popover,
popover.background,
popover.menu {
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    border-radius: 10px;

    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
}

menuitem {
    background-color: transparent;
    color: @sunflower_text;

    border-radius: 6px;

    padding: 7px 10px;
}

menuitem:hover {
    background-color: @sunflower_surface_hover;
    color: @sunflower_text;
}

menuitem:active,
menuitem:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ============================================================
 * Lists / tree views / Thunar
 * ============================================================ */

treeview,
treeview.view,
.view {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

treeview:hover,
treeview.view:hover,
.view:hover {
    background-color: @sunflower_surface;
}

treeview:selected,
treeview.view:selected,
.view:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

treeview:selected:focus,
treeview.view:selected:focus,
.view:selected:focus {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* Thunar icon/list rows */

iconview {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

iconview:hover {
    background-color: @sunflower_surface;
}

iconview:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ============================================================
 * Sidebar
 * ============================================================ */

.sidebar,
.sidebar.view {
    background-color: @sunflower_surface;
    color: @sunflower_text;
}

.sidebar row {
    background-color: transparent;
    color: @sunflower_text;
    border-radius: 7px;
    padding: 5px;
}

.sidebar row:hover {
    background-color: @sunflower_surface_hover;
}

.sidebar row:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ============================================================
 * Scrollbars
 * ============================================================ */

scrollbar {
    background-color: transparent;
}

scrollbar trough {
    background-color: transparent;
    border-radius: 8px;
}

scrollbar slider {
    background-color: @sunflower_text_muted;
    border-radius: 8px;

    min-width: 7px;
    min-height: 7px;
}

scrollbar slider:hover {
    background-color: @sunflower_text_secondary;
}

scrollbar slider:active {
    background-color: @sunflower_accent;
}

/* ============================================================
 * Scale / sliders
 * ============================================================ */

scale trough {
    background-color: @sunflower_surface_hover;
    border-radius: 5px;
}

scale highlight {
    background-color: @sunflower_accent;
    border-radius: 5px;
}

scale slider {
    background-color: @sunflower_accent;
    border: 2px solid @sunflower_background;
    border-radius: 50%;
}

/* ============================================================
 * Checkboxes / radio buttons
 * ============================================================ */

checkbutton,
radiobutton {
    color: @sunflower_text;
}

checkbutton check,
radiobutton radio {
    background-color: @sunflower_surface;
    border: 1px solid @sunflower_text_muted;
}

checkbutton:hover check,
radiobutton:hover radio {
    border-color: @sunflower_accent;
}

checkbutton:checked check,
radiobutton:checked radio {
    background-color: @sunflower_accent;
    color: @sunflower_background;
    border-color: @sunflower_accent;
}

/* ============================================================
 * Switch
 * ============================================================ */

switch {
    background-color: @sunflower_surface_hover;
    border: 1px solid @sunflower_text_muted;
    border-radius: 999px;
}

switch slider {
    background-color: @sunflower_text;
    border-radius: 999px;
}

switch:checked {
    background-color: @sunflower_accent;
    border-color: @sunflower_accent;
}

switch:checked slider {
    background-color: @sunflower_background;
}

/* ============================================================
 * Progress bars
 * ============================================================ */

progressbar trough {
    background-color: @sunflower_surface_hover;
    border-radius: 6px;
}

progressbar progress {
    background-color: @sunflower_accent;
    border-radius: 6px;
}

/* ============================================================
 * Tabs
 * ============================================================ */

notebook {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

notebook header {
    background-color: @sunflower_surface;
    border: none;
}

notebook tab {
    background-color: transparent;
    color: @sunflower_text_secondary;
    padding: 7px 12px;
}

notebook tab:hover {
    background-color: @sunflower_surface_hover;
    color: @sunflower_text;
}

notebook tab:checked {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ============================================================
 * Tooltips
 * ============================================================ */

tooltip {
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    border-radius: 8px;

    padding: 6px 9px;
}

/* ============================================================
 * Separators
 * ============================================================ */

separator {
    background-color: @sunflower_surface_hover;
}

/* ============================================================
 * Links
 * ============================================================ */

*:link,
*:visited {
    color: @sunflower_accent;
}

*:link:hover,
*:visited:hover {
    color: @sunflower_cyan;
}

/* ============================================================
 * Selection / focus
 * ============================================================ */

*:focus {
    outline-color: @sunflower_accent;
}

selection,
*:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ============================================================
 * Destructive / warning / success
 * ============================================================ */

.destructive-action {
    background-color: @sunflower_error;
    color: @sunflower_background;
}

.destructive-action:hover {
    background-color: @sunflower_error;
}

.suggested-action {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

.warning {
    color: @sunflower_warning;
}

.success {
    color: @sunflower_success;
}

/* ============================================================
 * SUNFLOWER — GLOBAL DARK OVERRIDE
 *
 * This section intentionally comes LAST so it wins against
 * earlier/default GTK styling.
 * ============================================================ */

/* ------------------------------------------------------------
 * GTK semantic theme colors
 * ------------------------------------------------------------ */

@define-color theme_fg_color              @sunflower_text;
@define-color theme_text_color            @sunflower_text;
@define-color theme_bg_color              @sunflower_background;
@define-color theme_base_color            @sunflower_background;

@define-color theme_unfocused_fg_color    @sunflower_text_secondary;
@define-color theme_unfocused_text_color  @sunflower_text_secondary;
@define-color theme_unfocused_bg_color    @sunflower_background;
@define-color theme_unfocused_base_color  @sunflower_background;

@define-color insensitive_fg_color        @sunflower_text_muted;
@define-color insensitive_bg_color        @sunflower_surface;
@define-color insensitive_base_color      @sunflower_background;

@define-color borders                      @sunflower_surface_hover;
@define-color unfocused_borders            @sunflower_surface;

@define-color theme_selected_bg_color      @sunflower_accent;
@define-color theme_selected_fg_color      @sunflower_background;

@define-color content_view_bg              @sunflower_background;
@define-color text_view_bg                 @sunflower_background;

/* ------------------------------------------------------------
 * EVERYTHING
 * ------------------------------------------------------------ */

* {
    color: @sunflower_text;
}

/* ------------------------------------------------------------
 * Windows
 * ------------------------------------------------------------ */

window,
window.background,
window.csd,
window.solid-csd,
window.unified,
window > decoration {
    background-color: @sunflower_background;
    color: @sunflower_text;
    border-color: @sunflower_surface_hover;
}

/* ------------------------------------------------------------
 * GTK client-side decoration
 * ------------------------------------------------------------ */

decoration,
decoration.background,
decoration:backdrop {
    background-color: @sunflower_background;
    border: 1px solid @sunflower_surface_hover;
    box-shadow: none;
}

/* ------------------------------------------------------------
 * Menubars
 * ------------------------------------------------------------ */

menubar,
menubar.background {
    background-color: @sunflower_background;
    color: @sunflower_text;
    border: none;
    box-shadow: none;
}

menubar > menuitem {
    background-color: transparent;
    color: @sunflower_text_secondary;
}

menubar > menuitem:hover,
menubar > menuitem:focus {
    background-color: @sunflower_surface_hover;
    color: @sunflower_text;
}

menubar > menuitem:active,
menubar > menuitem:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ------------------------------------------------------------
 * Toolbars
 * ------------------------------------------------------------ */

toolbar,
.toolbar,
.primary-toolbar {
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border: none;
    box-shadow: none;
}

toolbar > *,
.toolbar > *,
.primary-toolbar > * {
    color: @sunflower_text;
}

/* ------------------------------------------------------------
 * Frames / containers
 * ------------------------------------------------------------ */

frame,
frame > border,
viewport,
scrolledwindow,
scrolledwindow > viewport,
stack,
stacksidebar,
paned,
eventbox,
box {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

/* ------------------------------------------------------------
 * Main views
 * ------------------------------------------------------------ */

.view,
.view text,
treeview,
treeview.view,
iconview,
textview,
textview.view {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

/* ------------------------------------------------------------
 * Headerbars
 * ------------------------------------------------------------ */

headerbar,
headerbar.background,
.titlebar,
.titlebar.background {
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border: none;
    box-shadow: none;
}

headerbar:backdrop,
.titlebar:backdrop {
    background-color: @sunflower_background;
    color: @sunflower_text_muted;
}

/* ------------------------------------------------------------
 * Buttons
 * ------------------------------------------------------------ */

button {
    background-image: none;
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    box-shadow: none;
}

button:hover {
    background-color: @sunflower_surface_hover;
    color: @sunflower_text;
}

button:active,
button:checked,
button:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

button:disabled {
    background-color: @sunflower_background;
    color: @sunflower_text_muted;
