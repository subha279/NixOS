entry,
entry.background,
spinbutton,
combobox {
    background-color: @sunflower_surface;
    color: @sunflower_text;

    border-color: @sunflower_surface_hover;
}

entry:focus,
spinbutton:focus,
combobox:focus {
    background-color: @sunflower_surface;
    color: @sunflower_text;
    border-color: @sunflower_accent;
}

/* ------------------------------------------------------------
 * Lists / rows
 * ------------------------------------------------------------ */

list,
listview,
row {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

row:hover,
list row:hover {
    background-color: @sunflower_surface;
    color: @sunflower_text;
}

row:selected,
list row:selected,
.view:selected,
treeview:selected,
iconview:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ------------------------------------------------------------
 * Sidebar
 * ------------------------------------------------------------ */

.sidebar,
.sidebar.view,
stacksidebar {
    background-color: @sunflower_surface;
    color: @sunflower_text;
}

.sidebar row,
.sidebar.view row {
    background-color: transparent;
    color: @sunflower_text_secondary;
}

.sidebar row:hover,
.sidebar.view row:hover {
