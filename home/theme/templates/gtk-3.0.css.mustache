    border: 1px solid @sunflower_surface_hover;
    box-shadow: none;
}

menuitem,
modelbutton {
    background-color: transparent;
    color: @sunflower_text;
}

menuitem:hover,
modelbutton:hover {
    background-color: @sunflower_surface_hover;
    color: @sunflower_text;
}

menuitem:selected,
menuitem:active,
modelbutton:active {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

/* ------------------------------------------------------------
 * Scrollbars
 * ------------------------------------------------------------ */

scrollbar,
scrollbar trough {
