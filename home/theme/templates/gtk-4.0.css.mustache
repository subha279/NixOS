/* ============================================================
 * Sunflower GTK 4
 * ============================================================ */

@define-color sunflower_background #{{base00-hex}};
@define-color sunflower_surface #{{base01-hex}};
@define-color sunflower_surface_hover #{{base02-hex}};
@define-color sunflower_text_muted #{{base03-hex}};
@define-color sunflower_text_secondary #{{base04-hex}};
@define-color sunflower_text #{{base05-hex}};

@define-color sunflower_error #{{base08-hex}};
@define-color sunflower_warning #{{base09-hex}};
@define-color sunflower_yellow #{{base0A-hex}};
@define-color sunflower_success #{{base0B-hex}};
@define-color sunflower_cyan #{{base0C-hex}};
@define-color sunflower_info #{{base0D-hex}};
@define-color sunflower_accent #{{base0E-hex}};
@define-color sunflower_magenta #{{base0F-hex}};

/* Base */

window,
.background {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

/* ============================================================
 * Global GTK4 window styling
 * ============================================================ */

window {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

window.background {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

/* Client-side decoration */

decoration {
    background-color: @sunflower_background;
    border: 1px solid @sunflower_surface_hover;
    border-radius: 12px;
    box-shadow: 0 3px 6px alpha(black, 0.14),
                0 12px 28px alpha(black, 0.28);
}

decoration:backdrop {
    border-color: @sunflower_surface;
    box-shadow: 0 2px 4px alpha(black, 0.10),
                0 8px 20px alpha(black, 0.20);
}

/* ============================================================
 * Menubar
 * ============================================================ */

menubar {
    background-color: @sunflower_background;
    color: @sunflower_text;

    border: none;
    box-shadow: none;
}

menubar > item {
    background-color: transparent;
    color: @sunflower_text_secondary;
}

menubar > item:hover {
    background-color: @sunflower_surface_hover;
    color: @sunflower_text;
}

menubar > item:active,
menubar > item:selected {
    background-color: @sunflower_accent;
    color: @sunflower_background;
}

.view {
    background-color: @sunflower_background;
    color: @sunflower_text;
}

/* Headerbars */

headerbar {
    background: @sunflower_surface;
    color: @sunflower_text;

    min-height: 42px;
    padding: 5px 8px;

    border: none;
    box-shadow: none;
}

headerbar:backdrop {
    background: @sunflower_background;
    color: @sunflower_text_muted;
}

/* Buttons */

button {
    background: @sunflower_surface;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    border-radius: 8px;

    box-shadow: none;

    padding: 6px 12px;
}

button:hover {
    background: @sunflower_surface_hover;
    border-color: @sunflower_accent;
}

button:focus,
button:focus-visible {
    border-color: @sunflower_accent;
    box-shadow: 0 0 0 2px alpha(@sunflower_accent, 0.25);
}

button:active,
button:checked {
    background: @sunflower_accent;
    color: @sunflower_background;
    border-color: @sunflower_accent;
}

button:disabled {
    background: @sunflower_background;
    color: @sunflower_text_muted;
}

/* Entries */

entry {
    background: @sunflower_surface;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    border-radius: 8px;

    padding: 7px 10px;
}

entry:hover {
    border-color: @sunflower_text_secondary;
}

entry:focus {
    border-color: @sunflower_accent;
    box-shadow: 0 0 0 2px alpha(@sunflower_accent, 0.25);
}

/* Lists */

list,
listview,
columnview,
treeview {
    background: @sunflower_background;
    color: @sunflower_text;
}

row {
    background: transparent;
    color: @sunflower_text;

    border-radius: 7px;
}

row:hover {
    background: @sunflower_surface;
}

row:selected {
    background: @sunflower_accent;
    color: @sunflower_background;
}

/* Sidebar */

.sidebar {
    background: @sunflower_surface;
    color: @sunflower_text;
}

.sidebar row:hover {
    background: @sunflower_surface_hover;
}

.sidebar row:selected {
    background: @sunflower_accent;
    color: @sunflower_background;
}

/* Menus / popovers */

popover,
popover.menu {
    background: @sunflower_surface;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    border-radius: 12px;
    box-shadow: 0 6px 16px alpha(black, 0.20),
                0 2px 4px alpha(black, 0.16);
}

popover modelbutton {
    color: @sunflower_text;
    border-radius: 6px;
}

popover modelbutton:hover {
    background: @sunflower_surface_hover;
}

popover modelbutton:active {
    background: @sunflower_accent;
    color: @sunflower_background;
}

/* Scrollbars */

scrollbar {
    background: transparent;
}

scrollbar slider {
    background: @sunflower_text_muted;
    border-radius: 999px;

    min-width: 7px;
    min-height: 7px;
}

scrollbar slider:hover {
    background: @sunflower_text_secondary;
}

scrollbar slider:active {
    background: @sunflower_accent;
}

/* Scale */

scale trough {
    background: @sunflower_surface_hover;
    border-radius: 6px;
}

scale highlight {
    background: @sunflower_accent;
    border-radius: 6px;
}

scale slider {
    background: @sunflower_accent;
}

/* Check / radio */

checkbutton,
radiobutton {
    color: @sunflower_text;
}

check,
radio {
    background: @sunflower_surface;
    border: 1px solid @sunflower_text_muted;
}

check:checked,
radio:checked {
    background: @sunflower_accent;
    color: @sunflower_background;
    border-color: @sunflower_accent;
}

/* Switch */

switch {
    background: @sunflower_surface_hover;
    border: 1px solid @sunflower_text_muted;
    border-radius: 999px;
}

switch slider {
    background: @sunflower_text;
    border-radius: 999px;
}

switch:checked {
    background: @sunflower_accent;
    border-color: @sunflower_accent;
}

/* Progress */

progressbar trough {
    background: @sunflower_surface_hover;
    border-radius: 6px;
}

progressbar progress {
    background: @sunflower_accent;
    border-radius: 6px;
}

/* Tooltips */

tooltip {
    background: @sunflower_surface;
    color: @sunflower_text;

    border: 1px solid @sunflower_surface_hover;
    border-radius: 8px;
}

/* Separators */

separator {
    background: @sunflower_surface_hover;
}

/* Links */

*:link,
*:visited {
    color: @sunflower_accent;
}

*:link:hover,
*:visited:hover {
    color: @sunflower_cyan;
}

